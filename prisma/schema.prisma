generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model News {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  category      String?
  excerpt       String?
  body          String
  coverImageUrl String?
  /// Logo-style covers must letterbox instead of crop.
  imageFit      ImageFit   @default(COVER)
  status        NewsStatus @default(DRAFT)
  publishedAt   DateTime?
  order         Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

enum ImageFit {
  COVER
  CONTAIN
}

/// YouTube videos shown in the home page News & Events strip.
model HomeVideo {
  id        String   @id @default(cuid())
  /// 11-character YouTube video id, extracted from whatever URL the admin pastes.
  videoId   String
  title     String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Executive {
  id        String          @id @default(cuid())
  name      String
  title     String
  photoUrl  String?
  order     Int             @default(0)
  category  ExecutiveCategory
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum ExecutiveCategory {
  EXECUTIVE
  DIRECTOR
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model MembershipApplication {
  id           String            @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String
  businessType String
  address      String
  message      String?
  documentUrl  String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Resource {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  excerpt        String?
  body           String
  coverImageUrl  String?
  eventDate      DateTime?
  location       String?
  bookingEnabled Boolean        @default(true)
  emailSubject   String?
  emailBody      String?
  status         ResourceStatus @default(DRAFT)
  order          Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bookings       SeatBooking[]
}

enum ResourceStatus {
  DRAFT
  PUBLISHED
}

model SeatBooking {
  id           String   @id @default(cuid())
  resourceId   String
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String
  organization String
  createdAt    DateTime @default(now())

  @@unique([resourceId, email])
  @@index([resourceId])
}

model StallBooking {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String
  organization String
  createdAt    DateTime @default(now())
}

model VisitorRegistration {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String
  profession String
  createdAt  DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// One admin-composed bulk email. Recipients are snapshotted at creation time
/// (see EmailRecipient) so history stays accurate after the source rows change.
model EmailCampaign {
  id            String           @id @default(cuid())
  subject       String
  body          String
  /// Human-readable description of who was picked, e.g. "Approved members (142)".
  audienceLabel String
  status        CampaignStatus   @default(DRAFT)
  totalCount    Int              @default(0)
  sentCount     Int              @default(0)
  failedCount   Int              @default(0)
  sentAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  recipients    EmailRecipient[]

  @@index([createdAt])
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

model EmailRecipient {
  id           String          @id @default(cuid())
  campaignId   String
  campaign     EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email        String
  name         String
  /// Feeds the {{businessName}} / {{organization}} tokens.
  organization String          @default("")
  status       RecipientStatus @default(PENDING)
  /// Resend error text when status is FAILED.
  error        String?
  /// Resend message id when status is SENT.
  providerId   String?
  sentAt       DateTime?

  @@unique([campaignId, email])
  @@index([campaignId, status])
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
}
